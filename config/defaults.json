{
  "format": { "width": 1080, "height": 1920, "fps": 30 },
  "duration_seconds": { "minimum": 30, "maximum": 90, "default": 60 },
  "budget": {
    "allow_paid_providers": false,
    "max_ai_calls_per_job": 8,
    "max_generated_images_per_job": 8,
    "max_retries_per_stage": 2,
    "stop_on_budget_exhaustion": true
  },
  "delivery": { "publish_automatically": false, "manual_review_required": true },
  "providers": {
    "planning": "gemini",
    "narration": "piper-local-or-configured-provider",
    "visual_assets": "licensed-media-or-ai-image-provider",
    "rendering": "hyperframes"
  }
}
